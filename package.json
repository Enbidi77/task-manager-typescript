{
  "name": "taskpulse-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TaskPulse — Extensible System Resource Monitor (TypeScript Monorepo)",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "dev": "turbo run dev --concurrency 15",
    "cli": "pnpm --filter @taskpulse/cli start",
    "cli:dev": "pnpm --filter @taskpulse/cli dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "packageManager": "pnpm@10.33.4"
}
