{
  "name": "@taskpulse/monitoring",
  "version": "0.1.0",
  "description": "Sampling coordination, rate calculation, alert evaluation, and snapshot engine for TaskPulse",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@taskpulse/core": "workspace:*",
    "@taskpulse/logging": "workspace:*",
    "@taskpulse/shared": "workspace:*",
    "@taskpulse/storage": "workspace:*"
  },
  "devDependencies": {
    "@taskpulse/testing": "workspace:*",
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
