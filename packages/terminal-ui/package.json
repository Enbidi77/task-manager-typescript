{
  "name": "@taskpulse/terminal-ui",
  "version": "0.1.0",
  "description": "Interactive Ink and React terminal user interface for TaskPulse",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@taskpulse/config": "workspace:*",
    "@taskpulse/core": "workspace:*",
    "@taskpulse/monitoring": "workspace:*",
    "@taskpulse/shared": "workspace:*",
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@taskpulse/testing": "workspace:*",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
